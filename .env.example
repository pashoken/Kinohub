# KinoHub server box: copy to .env and replace every CHANGE_ME value.
# This file is the only deployment configuration file. Never commit .env.
APP_MODE=live
PUBLIC_APP_ORIGIN=http://CHANGE_ME_SERVER_IP:4100
KINOHUB_PORT=4100
LAN_BIND=0.0.0.0
# Keep admin panels local after setup. Temporarily use 0.0.0.0 on a trusted LAN.
ADMIN_BIND=127.0.0.1
TZ=Etc/UTC

# Seerr supplies the live catalog and search.
SEERR_URL=http://CHANGE_ME_SEERR_HOST:5055
SEERR_API_KEY=CHANGE_ME_SEERR_API_KEY

# Jackett supplies torrent search results.
JACKETT_URL=http://CHANGE_ME_JACKETT_HOST:9117
# TorrServer downloads the selected .torrent through this URL. It must be
# reachable from the TorrServer container (for one Docker network: http://jackett:9117).
PUBLIC_JACKETT_URL=http://CHANGE_ME_JACKETT_HOST:9117
JACKETT_API_KEY=CHANGE_ME_JACKETT_API_KEY

# TorrServer prepares and streams selected releases.
TORRSERVER_URL=http://CHANGE_ME_TORRSERVER_HOST:8090
PUBLIC_TORRSERVER_URL=http://CHANGE_ME_SERVER_IP:8090

# Optional rating provider keys. Leave blank when unused.
KINOPOISK_API_KEY=
POISKKINO_API_KEY=

# Optional diagnostics / bundled-stack settings.
JELLYFIN_URL=
PUID=1000
PGID=1000
SEERR_PORT=5055
JACKETT_PORT=9117
TORRSERVER_PORT=8090
JELLYFIN_PORT=8096
